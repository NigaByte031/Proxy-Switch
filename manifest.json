{
  "manifest_version": 3,
  "name": "Proxy Switch",
  "version": "1.0.0",
  "description": "Switch Chrome between system, direct, manual HTTP/SOCKS and PAC proxies in one click. English and Persian UI, works offline.",
  "homepage_url": "https://github.com/your-username/proxy-switch",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Proxy Switch",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "src/options.html",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "proxy",
    "storage",
    "webRequest",
    "webRequestAuthProvider",
    "contextMenus"
  ],
  "host_permissions": ["<all_urls>"]
}
